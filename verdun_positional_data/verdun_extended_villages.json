  "lorraine_village_architecture": {
    "traditional_layout": {
      "type": "street-village (village-rue)",
      "description": "Two lines of houses stretching along main street, carefully aligned",
      "orientation": "Houses face south/sun for warmth",
      "pattern": "Linear along road, fostering conviviality and interaction",
      "spacing": "Houses close together on street, with large rear gardens",
      "communal_spaces": "Wide spaces for storing wood and agricultural tools"
    },
    "building_materials": {
      "walls": [
        "Half-timber (colombage) - exposed wooden framework",
        "Local limestone - from Meuse quarries",
        "Puddled clay - rammed earth",
        "Stone and timber combination"
      ],
      "roofs": [
        "Clay tiles (most common by 1900)",
        "Slate (wealthier buildings)",
        "Thatch (older farm buildings, declining by 1914)"
      ],
      "colors": "Natural stone grey, white lime-wash, earth tones"
    },
    "typical_buildings": {
      "maison_lorraine": {
        "description": "Traditional Lorraine house",
        "features": [
          "2-3 stories",
          "Half-timbered upper floors",
          "Stone ground floor",
          "Large barn door (porte charretière)",
          "Living quarters above stables/storage"
        ],
        "dimensions": "8-12m wide, 12-18m deep, 8-10m tall"
      },
      "ferme_lorraine": {
        "description": "Traditional Lorraine farm",
        "layout": "U-shape or rectangular courtyard",
        "features": [
          "Living quarters",
          "Barn (grange)",
          "Stable (étable)",
          "Courtyard (cour)",
          "Large gate entrance"
        ],
        "dimensions": "15-25m wide, 20-35m deep"
      },
      "eglise_village": {
        "description": "Village church",
        "style": "Romanesque or Neo-Gothic (19th century)",
        "features": [
          "Stone construction",
          "Bell tower (clocher)",
          "Nave and apse",
          "Often on elevated ground"
        ],
        "dimensions": "20-30m long, 8-12m wide, tower 15-25m tall"
      }
    }
  },

